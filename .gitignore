# Private authoring runs and provisioning data
.each/
.architrave/runs/
.architrave/worktrees/
.architrave/run.json
.architrave/evidence/
models/weights/
shadow/
# M7's approved, immutable spec hard-codes allowed_paths under
# examples/clean-room-lru-cache/shadow/ (the path cannot be renamed without
# invalidating the human-approved spec hash). This fixture is EACH-authored,
# public, and derived only from the public spec -- it is intentionally
# tracked, unlike real private/Xodus shadow-only material.
!examples/clean-room-lru-cache/shadow/
!examples/clean-room-lru-cache/shadow/**
*.pem
*.key
.env
.env.*
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/

# Architrave: private run evidence and isolated worker trees stay local.
.architrave/runtime.key
.architrave/resources.lock
examples/xodus-m8-sandbox-id/.build/
